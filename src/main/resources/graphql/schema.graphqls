type Query {
    concept(uri: String!): Concept
    schemes: [ConceptScheme]
    searchConcepts(text: String!, limit: Int = 20, lang: String = "sl"): [Concept]
    conceptNeighborhood(uri: String!): [Concept!]!
    conceptNeighborhoodEdges(uri: String!): [ConceptEdge!]!
}

type Concept {
    uri: String!
    prefLabel: String      # Resolves to getPrefLabel() (Slovenian fallback logic)
    prefLabelSl: String    # Clean Slovenian string
    prefLabelEn: String    # Clean English string
    definition: String
    broader: [Concept]
    scopeNote: String      # <-- add this
    narrower: [Concept]
    related: [Concept]
}

type ConceptEdge {
    sourceUri: String!
    targetUri: String!
    relationType: String!
}

type ConceptScheme {
    uri: String!
    title: String
    description: String
    topConcepts: [Concept]
}